{
  "id": "/",
  "name": "Bloom — habits, mood & cycle",
  "short_name": "Bloom",
  "description": "Your record, read back to you: habits, mood, sleep, study and cycle — private, device-first, and yours to export at any time.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "background_color": "#14151f",
  "theme_color": "#14151f",
  "orientation": "portrait-primary",
  "categories": [
    "health",
    "lifestyle",
    "productivity"
  ],
  "icons": [
    {
      "src": "/bloom/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
