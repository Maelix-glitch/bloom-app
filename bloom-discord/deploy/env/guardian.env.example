# Guardian — production environment
#
# Copy to deploy/env/guardian.env and fill in. That file is git-ignored.
#
# This file holds exactly two secrets: Guardian's Discord token and Guardian's
# database password. It must not contain Companion's token, Labs' token, or the
# migration credential. If you find yourself adding one of those, the thing you
# are trying to do belongs in a different service.

# ── Identity ─────────────────────────────────────────────────────────────────
DISCORD_GUARDIAN_TOKEN=
DISCORD_GUARDIAN_CLIENT_ID=
DISCORD_GUILD_ID=

# ── Database ─────────────────────────────────────────────────────────────────
# The bloom_guardian role from database/security/0001_runtime_roles.sql.
# Not the Supabase `postgres` superuser, and not bloom_migrator.
# Use the transaction pooler host, not the direct connection.
DATABASE_URL=postgresql://bloom_guardian:CHANGE_ME@db.example.supabase.co:6543/postgres
DATABASE_SCHEMA=bloom_discord
DATABASE_MAX_CONNECTIONS=5

# ── Roles Guardian manages ───────────────────────────────────────────────────
DISCORD_ROLE_FOUNDER=
DISCORD_ROLE_ADMINISTRATOR=
DISCORD_ROLE_MODERATOR=
DISCORD_ROLE_BLOOM_BOT=
DISCORD_ROLE_BETA_TESTER=
DISCORD_ROLE_EARLY_BLOOM=
DISCORD_ROLE_BLOOM_MEMBER=

# ── Channels ─────────────────────────────────────────────────────────────────
DISCORD_CHANNEL_WELCOME=
DISCORD_CHANNEL_MOD_LOG=
DISCORD_CHANNEL_AUDIT_LOG=
DISCORD_CHANNEL_REPORTS=

# ── Runtime ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_PRETTY=false
HEALTH_PORT=8080
BLOOM_TIMEZONE=Europe/London
FEATURE_SCHEDULED_MESSAGES=true
