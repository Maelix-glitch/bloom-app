# Labs — production environment
#
# Labs' token and Labs' database role. Labs holds no identity, no economy and
# no moderation surface, and its database role is scoped to say so.

DISCORD_LABS_TOKEN=
DISCORD_LABS_CLIENT_ID=
DISCORD_GUILD_ID=

DATABASE_URL=postgresql://bloom_labs:CHANGE_ME@db.example.supabase.co:6543/postgres
DATABASE_SCHEMA=bloom_discord
DATABASE_MAX_CONNECTIONS=3

DISCORD_ROLE_FOUNDER=
DISCORD_ROLE_ADMINISTRATOR=
DISCORD_ROLE_MODERATOR=
DISCORD_ROLE_BETA_TESTER=
DISCORD_ROLE_BLOOM_MEMBER=

DISCORD_CHANNEL_BETA_LOUNGE=
DISCORD_CHANNEL_BUG_REPORTS=
DISCORD_CHANNEL_FEEDBACK=

LOG_LEVEL=info
LOG_PRETTY=false
HEALTH_PORT=8082
BLOOM_TIMEZONE=Europe/London
