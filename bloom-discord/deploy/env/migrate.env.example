# Migrations — production environment
#
# The ONLY file that carries bloom_migrator, the role that can create and drop
# objects. It is used by a one-shot service behind the `migrate` profile and is
# never mounted into a running bot.
#
# No Discord token belongs here. The migrator does not connect to Discord.

DATABASE_URL=postgresql://bloom_migrator:CHANGE_ME@db.example.supabase.co:6543/postgres
DATABASE_SCHEMA=bloom_discord
DATABASE_MAX_CONNECTIONS=2

# The loader requires these to build a platform config even for a CLI that
# never connects to the gateway. Any valid snowflake works; nothing reads them.
DISCORD_GUILD_ID=000000000000000000

LOG_LEVEL=info
LOG_PRETTY=false
