# Companion — production environment
#
# Companion's token and Companion's database role. Nothing else.
# Companion is the only bot that touches the points ledger; its database role
# cannot read a moderation case or a report, and cannot create a referral.

DISCORD_COMPANION_TOKEN=
DISCORD_COMPANION_CLIENT_ID=
DISCORD_GUILD_ID=

DATABASE_URL=postgresql://bloom_companion:CHANGE_ME@db.example.supabase.co:6543/postgres
DATABASE_SCHEMA=bloom_discord
DATABASE_MAX_CONNECTIONS=5

DISCORD_ROLE_FOUNDER=
DISCORD_ROLE_ADMINISTRATOR=
DISCORD_ROLE_MODERATOR=
DISCORD_ROLE_BETA_TESTER=
DISCORD_ROLE_EARLY_BLOOM=
DISCORD_ROLE_BLOOM_MEMBER=

DISCORD_CHANNEL_DAILY_CHECK_IN=
DISCORD_CHANNEL_SMALL_WINS=
DISCORD_CHANNEL_MILESTONES=
DISCORD_CHANNEL_ACHIEVEMENTS=
DISCORD_CHANNEL_CHALLENGES=
DISCORD_CHANNEL_BLOOM_REWARDS=

LOG_LEVEL=info
LOG_PRETTY=false
HEALTH_PORT=8081
BLOOM_TIMEZONE=Europe/London
FEATURE_SCHEDULED_MESSAGES=true
FEATURE_REWARDS=true
