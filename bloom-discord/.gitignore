# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
*.tsbuildinfo
coverage/

# Secrets — never commit. Only `.example` templates are tracked.
.env
.env.*
!.env.example

# Per-service production environment files (docker-compose.prod.yml).
# `.env` above does not cover these: a gitignore pattern with no slash matches
# a basename, and `guardian.env` is not `.env`. Without this line the file
# holding Guardian's token would be committable.
deploy/env/*.env
!deploy/env/*.env.example

# Logs
*.log
logs/

# Editor / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
