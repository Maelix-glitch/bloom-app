# =============================================================================
# Bloom Labs Discord Platform — environment template
# =============================================================================
#
#   cp .env.example .env
#
# `.env` is git-ignored and must stay that way. Placeholders only in this file:
# a real token committed here is a token that has to be rotated.
#
# Validation happens at boot (packages/config). A missing or malformed required
# value fails the process immediately and names the exact key — the bot never
# boots half-configured.
#
# Run `pnpm diagnostics` after filling this in. It reports every resolved value
# with secrets redacted, and tells you what is still missing.
# =============================================================================


# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
NODE_ENV=development

# Shown in logs and /health. development | staging | production
BLOOM_ENVIRONMENT=development

# trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# Human-readable log output. Development only — production must stay JSON so the
# log pipeline can parse it.
LOG_PRETTY=true


# -----------------------------------------------------------------------------
# Discord — guild
# -----------------------------------------------------------------------------
# The Bloom Labs server id. Enable Developer Mode in Discord
# (Settings -> Advanced -> Developer Mode), then right-click the server -> Copy Server ID.
DISCORD_GUILD_ID=000000000000000000


# -----------------------------------------------------------------------------
# Discord — three separate applications
# -----------------------------------------------------------------------------
# Each bot is its own application in the Discord Developer Portal with its own
# token. Never reuse a token between bots: config validation rejects duplicates,
# because a shared token means two processes answering as one identity.
#
# Tokens are reset from Developer Portal -> your app -> Bot -> Reset Token.
# See docs/deployment/discord-developer-portal-setup.md

DISCORD_GUARDIAN_TOKEN=your-guardian-bot-token
DISCORD_GUARDIAN_CLIENT_ID=000000000000000000

DISCORD_COMPANION_TOKEN=your-companion-bot-token
DISCORD_COMPANION_CLIENT_ID=000000000000000000

DISCORD_LABS_TOKEN=your-labs-bot-token
DISCORD_LABS_CLIENT_ID=000000000000000000


# -----------------------------------------------------------------------------
# Database — Supabase PostgreSQL
# -----------------------------------------------------------------------------
# Use the CONNECTION POOLER URI (Supabase dashboard -> Project Settings ->
# Database -> Connection string -> Transaction pooler), not the direct
# connection: three long-lived bot processes will exhaust direct connections.
#
# This must be a least-privilege application role. Do NOT use the service-role
# key or the postgres superuser here. See docs/database/schema.md.
DATABASE_URL=postgresql://user:password@host:6543/postgres?sslmode=require

# Bot tables live in their own schema so they never collide with the Bloom app's
# `public` schema in the same project.
DATABASE_SCHEMA=bloom_discord

# Per process. Three bots plus scripts share the pooler budget — keep this low.
DATABASE_MAX_CONNECTIONS=5

# Seconds. 0 disables the idle timeout.
DATABASE_IDLE_TIMEOUT=30

# Seconds to wait for a connection before failing fast.
DATABASE_CONNECT_TIMEOUT=10


# -----------------------------------------------------------------------------
# Roles — IDs ONLY
# -----------------------------------------------------------------------------
# Names are for display. Never resolve a role by name: names are user-editable,
# and matching on one is how a bot ends up granting the wrong role.
#
# Right-click a role in Server Settings -> Roles -> Copy Role ID.
#
# ✦ Founder
ROLE_FOUNDER=000000000000000000
# ◈ Administrator
ROLE_ADMINISTRATOR=000000000000000000
# ⟡ Moderator
ROLE_MODERATOR=000000000000000000
# ◉ Bloom Bot — the managed integration role Guardian acts through
ROLE_BLOOM_BOT=000000000000000000
# ◌ Beta Tester — product testing access. NOT an onboarding role, NOT staff.
ROLE_BETA_TESTER=000000000000000000
# ✧ Early Bloom — newly verified, onboarding in progress. NOT "early access".
ROLE_EARLY_BLOOM=000000000000000000
# ❋ Bloom Member — normal verified community member
ROLE_BLOOM_MEMBER=000000000000000000


# -----------------------------------------------------------------------------
# Channels — IDs ONLY
# -----------------------------------------------------------------------------
# Right-click a channel -> Copy Channel ID. Leave a value blank if the channel
# does not exist yet; only the channels a given bot *requires* are enforced at
# that bot's boot.

# ✦ WELCOME
CHANNEL_WELCOME=
CHANNEL_RULES=
CHANNEL_GETTING_STARTED=

# 📢 BLOOM UPDATES
CHANNEL_ANNOUNCEMENTS=
CHANNEL_RELEASE_NOTES=
CHANNEL_DEVELOPMENT_UPDATES=

# 🌿 THE GARDEN
CHANNEL_INTRODUCTIONS=
CHANNEL_DAILY_CHECK_IN=
CHANNEL_SMALL_WINS=

# 🏆 PROGRESS
CHANNEL_ACHIEVEMENTS=
CHANNEL_MILESTONES=
CHANNEL_BLOOM_REWARDS=
CHANNEL_CHALLENGES=

# 🛠️ BLOOM LAB
CHANNEL_BETA_TESTING=
CHANNEL_FEATURE_TESTING=

# 💡 IDEAS & FEEDBACK
CHANNEL_FEEDBACK=
CHANNEL_FEATURE_REQUESTS=
CHANNEL_VOTING=
CHANNEL_FEATURE_STATUS=

# 🐛 BUGS & SUPPORT
CHANNEL_BUG_REPORTS=
CHANNEL_SUPPORT=

# 🔒 BLOOM TEAM — private. Moderation and report output goes here and nowhere else.
CHANNEL_MODERATION=
CHANNEL_REPORTS=
CHANNEL_INTERNAL=


# -----------------------------------------------------------------------------
# Feature flags — all default OFF
# -----------------------------------------------------------------------------
# Nothing automated turns itself on. A scheduled message that nobody enabled is
# a scheduled message that never runs.
FEATURE_SCHEDULED_MESSAGES=false
FEATURE_REWARDS=false
FEATURE_GITHUB_INTEGRATION=false
FEATURE_AI_INTEGRATION=false


# -----------------------------------------------------------------------------
# Command registration
# -----------------------------------------------------------------------------
# guild  -> registers to DISCORD_GUILD_ID, updates instantly. Use in development.
# global -> registers globally. Use in production.
COMMAND_REGISTRATION_SCOPE=guild


# =============================================================================
# Deliberately absent
# =============================================================================
# No AI provider keys. Bloom AI channels are curated/showcase content for now
# (see the brief, §16); when AI lands it will be a separate service behind an
# interface, not a hard-coded provider in the bot.
#
# No GitHub credentials. The GitHub integration exists as an interface only
# (§28); credentials arrive with the implementation, in Phase 6.
# =============================================================================
