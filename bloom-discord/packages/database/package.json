{
  "name": "@bloom/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PostgreSQL client, migrator, repository base and health probes.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --build",
    "clean": "tsc --build --clean"
  },
  "dependencies": {
    "@bloom/shared-types": "workspace:*",
    "@bloom/utils": "workspace:*",
    "@bloom/logging": "workspace:*",
    "postgres": "catalog:",
    "@bloom/config": "workspace:*"
  }
}
