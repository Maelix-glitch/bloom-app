{
  "name": "@bloom/discord",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The only package permitted to import discord.js. Adapter, ports and bot runtime.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --build",
    "clean": "tsc --build --clean"
  },
  "dependencies": {
    "@bloom/shared-types": "workspace:*",
    "@bloom/utils": "workspace:*",
    "@bloom/validation": "workspace:*",
    "@bloom/logging": "workspace:*",
    "@bloom/config": "workspace:*",
    "@bloom/database": "workspace:*",
    "@bloom/security": "workspace:*",
    "@bloom/permissions": "workspace:*",
    "@bloom/embeds": "workspace:*",
    "@bloom/commands": "workspace:*",
    "@bloom/events": "workspace:*",
    "discord.js": "catalog:"
  }
}
