{
  "name": "bloom-discord",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Bloom Labs Discord platform \u2014 Guardian, Companion and Labs.",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24.17.0",
    "pnpm": ">=12.0.0"
  },
  "scripts": {
    "build": "tsc --build",
    "build:clean": "tsc --build --clean",
    "typecheck": "tsc --build --force && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "pnpm run lint && pnpm run typecheck && pnpm run test",
    "db:migrate": "tsx packages/database/src/cli/migrate.ts",
    "db:status": "tsx packages/database/src/cli/migrate.ts --status",
    "db:seed": "tsx packages/database/src/cli/seed.ts",
    "db:migrate:prod": "node packages/database/dist/cli/migrate.js",
    "data:erase": "tsx packages/database/src/cli/erase.ts",
    "diagnostics": "tsx scripts/diagnostics/index.ts",
    "health": "tsx scripts/health-check/index.ts",
    "commands:register": "tsx scripts/register-commands/index.ts",
    "dev:guardian": "tsx watch apps/guardian/src/main.ts",
    "dev:companion": "tsx watch apps/companion/src/main.ts",
    "dev:labs": "tsx watch apps/labs/src/main.ts",
    "staging:gateway": "tsx scripts/staging/validate-gateway.ts",
    "staging:setup": "./scripts/staging/setup-staging.sh",
    "staging:validate": "./scripts/staging/validate-staging.sh",
    "staging:rehearse-image": "./scripts/staging/rehearse-image-build.sh"
  },
  "devDependencies": {
    "@bloom/shared-types": "workspace:*",
    "@bloom/utils": "workspace:*",
    "@bloom/validation": "workspace:*",
    "@bloom/logging": "workspace:*",
    "@bloom/config": "workspace:*",
    "@bloom/database": "workspace:*",
    "@bloom/security": "workspace:*",
    "@bloom/permissions": "workspace:*",
    "@bloom/embeds": "workspace:*",
    "@bloom/commands": "workspace:*",
    "@bloom/events": "workspace:*",
    "@bloom/discord": "workspace:*",
    "@bloom/testing": "workspace:*",
    "@eslint/js": "^10.0.1",
    "@types/node": "24.10.1",
    "@vitest/coverage-v8": "5.0.1",
    "eslint": "10.11.0",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vitest": "5.0.1"
  }
}
