# Bloom Discord — copy to .env and fill in. Never commit the real file.

# From https://discord.com/developers/applications → your app
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Right-click your server → Copy Server ID (Developer Mode on)
DISCORD_GUILD_ID=

# IANA timezone the garden lives in. Daily check-ins roll over, and
# 🌙・midnight-bloom opens (22:00) and closes (05:00), in this zone.
BLOOM_TZ=UTC

# Weekly community goal: total check-ins the whole garden aims for.
BLOOM_WEEKLY_GOAL=150

# Links surfaced in the guide and gate. Leave empty to hide the button.
BLOOM_APP_URL=
