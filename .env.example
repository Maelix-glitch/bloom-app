# Bloom — environment
#
# Copy this file to `.env` and fill in the two values from your Supabase
# project (Dashboard -> Project Settings -> API). Then RESTART the dev server:
# Vite only reads env files at startup, so editing one while it runs does
# nothing, which is a very easy hour to lose.
#
# Without these, Bloom still works — every feature falls back to this device —
# but there are no accounts, no sync, and no magic link, and the app now says
# so in the corner instead of failing silently.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional. The name of your coach Edge Function; defaults to "coach".
# VITE_COACH_FUNCTION=coach

# Optional, free. GIF search in the story editor lights up with either key —
# without one, uploads + the built-in Bloom Motion pack still work.
# GIPHY: a free key from https://developers.giphy.com (dashboard, "Create an App").
# VITE_GIPHY_API_KEY=your-giphy-key
# Tenor: a free key from Google Cloud Console (Tenor API).
# VITE_TENOR_API_KEY=your-tenor-key
