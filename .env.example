# Bloom — environment
#
# Copy this file to `.env` and fill in the two values from your Supabase
# project (Dashboard -> Project Settings -> API). Then RESTART the dev server:
# Vite only reads env files at startup, so editing one while it runs does
# nothing, which is a very easy hour to lose.
#
# Without these, Bloom still works — every feature falls back to this device —
# but there are no accounts, no sync, and no magic link, and the app now says
# so in the corner instead of failing silently.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional. The name of your coach Edge Function; defaults to "coach".
# VITE_COACH_FUNCTION=coach

# Optional. Web Push public key (npx web-push generate-vapid-keys). With it
# set AND Supabase configured, turning reminders on also subscribes the
# device for push while the app is closed (see supabase/functions/push-send).
# The matching PRIVATE key is a Supabase secret, never a client env.
# VITE_VAPID_PUBLIC_KEY=...

# GIFs and stickers in the story editor use GIPHY through the `giphy` Edge
# Function. The key is a Supabase secret, never a VITE_ client env:
#   supabase functions deploy giphy
#   supabase secrets set GIPHY_API_KEY=your-giphy-key
# Get a key at https://developers.giphy.com (dashboard, "Create an App").
